<?xml version="1.0"?>
<ruleset name="My rules"
         xmlns="http://pmd.sf.net/ruleset/1.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <description>
        Custom rules
        for my project
    </description>
    <exclude-pattern>*/tests/*</exclude-pattern>
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <cache>true</cache>
    <rule ref="rulesets/codesize.xml">
        <exclude name="NPathComplexity"/>
        <exclude name="TooManyMethods"/>
    </rule>
    <rule ref="rulesets/codesize.xml/NPathComplexity">
        <properties>
            <property name="minimum" value="300"/>
        </properties>
    </rule>
    <rule ref="rulesets/codesize.xml/TooManyMethods">
        <priority>2</priority>
        <properties>
            <property name="maxmethods">
                <value>30</value>
            </property>
            <property name="ignorepattern" value="(^(set|get|is))i"/>
        </properties>
    </rule>
    <rule ref="rulesets/naming.xml/ShortVariable">
        <properties>
            <property name="minimum" value="2"/>
        </properties>
    </rule>
    <rule name="LongMethodCustom" class="PHP_PMD_Rule_Design_LongMethod" message="Too long">
        <properties>
            <property name="minimum" value="80"/>
        </properties>
    </rule>
</ruleset>
