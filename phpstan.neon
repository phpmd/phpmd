includes:
    - vendor/shipmonk/dead-code-detector/rules.neon

parameters:
    paths:
        - src/
        - tests/php/
    rememberPossiblyImpureFunctionValues: false
    level: max
    exceptions:
        reportUncheckedExceptionDeadCatch: true
        implicitThrows: false
        check:
            missingCheckedExceptionInThrows: true
            tooWideThrowType: true
    shipmonkDeadCode:
        usageExcluders:
            tests:
                enabled: true
    ignoreErrors:
        -
            identifier: missingType.checkedException
            path: tests/*
        -
            identifier: method.impossibleType
            path: src/Rule/UnusedPrivateMethod.php
            count: 2
        # Yaml::DUMP_COMPACT_NESTED_MAPPING only exists since symfony/yaml 7.3
        -
            identifiers:
                - assignOp.invalid
                - argument.type
            path: src/Config/ConfigDumper.php
            reportUnmatched: false
        # Called from bin/phpmd and conf/phar_bootstrap.stub, which are not analysed
        -
            identifier: shipmonk.deadMethod
            messages:
                - '#^Unused PHPMD\\TextUI\\Command::set(MainScript|WorkerCommandName)\b#'
                - '#^Unused PHPMD\\TextUI\\LegacyArguments::(isLegacyInvocation|transform|deprecationMessage)\b#'
        # Attribute arguments are read from the source code, the attribute is never instantiated
        -
            identifier: shipmonk.deadProperty.neverRead
            path: src/Attribute/SuppressWarnings.php
        # The rules count the methods of these fixtures, nothing calls them
        -
            identifier: shipmonk.deadMethod
            path: tests/php/PHPMD/Regression/Sources/*
